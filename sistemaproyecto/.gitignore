# --- Exclusiones de Git ---

# Binarios, ejecutables y objetos compilados
*.exe
*.exe~
*.out
*.o
*.obj
*.dll

# Carpetas de compilacion
bin/
obj/
build/

# Configuracion de IDEs (especifico de cada maquina)
.vscode/
.idea/
*.user

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Archivos de historial de edicion
*~
*.bak
*.swp
